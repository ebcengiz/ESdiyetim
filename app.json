{
  "expo": {
    "name": "ESdiyet",
    "slug": "esdiyet",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "./plugins/with-ios-fmt-consteval-fix.js",
      "./plugins/with-ios-uiscene-lifecycle.js",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalori tahmini için galeriden yemek fotoğrafı seçmeniz gerekir.",
